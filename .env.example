# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is git-ignored.
# Set these same variables in Vercel → Project Settings → Environment Variables.

# Required: Shopify Admin API access token (permanent, scoped — see README for required scopes)
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required only for token (re)generation via /api/auth/callback — not needed for normal operation
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
